# ==============================================================================
# SAGAR NETRA 3D — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or configure in Render Dashboard)
# DO NOT commit real secrets or service-role keys to git.

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend.
# Local Development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production Render Deployment (replace with your actual Render backend URL):
# NEXT_PUBLIC_API_URL=https://sagar-netra-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Bind host and port.
# Render automatically injects $PORT at runtime (defaults to 8000 locally).
HOST=0.0.0.0
PORT=8000

# Path to the scientific dataset directory.
# Defaults to sagar-netra-deployment-data if present, else data/
DATA_DIR=sagar-netra-deployment-data

# Production frontend domain for CORS authorization.
# In addition to localhost, *.onrender.com origins are automatically permitted.
FRONTEND_URL=https://sagar-netra-frontend.onrender.com
# Additional comma-separated origins (optional):
# CORS_ORIGINS=https://sagar-netra-frontend.onrender.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. SUPABASE OBJECT STORAGE (Free Plan: 1 GB Storage, <= 50 MB per file)
# ------------------------------------------------------------------------------
# Supabase project URL:
SUPABASE_URL=https://wqdzzyeisvycfnhkzomu.supabase.co

# Supabase Storage Bucket name (default: sagar-netra-data)
SUPABASE_BUCKET=sagar-netra-data

# Supabase 'service_role' Secret Key
# REQUIRED ONLY for executing scripts/upload_deployment_dataset.py
# Obtain from: https://supabase.com/dashboard/project/wqdzzyeisvycfnhkzomu/settings/api
# NEVER expose this key in frontend code or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
